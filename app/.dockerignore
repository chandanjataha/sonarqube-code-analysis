# ================================================================
# .dockerignore — files excluded from Docker build context
# Keeps the build context small and fast
# ================================================================

# Node modules — reinstalled inside container via npm ci
node_modules
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Previous builds (builder stage runs a fresh one)
dist

# Git
.git
.gitignore
.gitattributes

# IDE / Editor
.vscode
.idea
*.swp
*.swo
.DS_Store
Thumbs.db

# Tests
coverage
*.test.ts
*.test.tsx
*.spec.ts
*.spec.tsx
__tests__

# CI / Docker itself
.dockerignore
Dockerfile
docker-compose*.yml
*.md

# OS
*.log
.env.local
.env.development
.env.*.local
